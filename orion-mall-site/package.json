{
  "name": "orion-mall-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Cinematic scroll-driven website for Orion Mall, Gorakhpur",
  "scripts": {
    "dev": "npm run build:frames && vite",
    "build": "npm run build:frames && vite build",
    "preview": "vite preview",
    "build:frames": "node scripts/build-frames.mjs",
    "generate:frames": "node scripts/generate-frames.mjs",
    "lint": "eslint src scripts --ext .js,.mjs",
    "format": "prettier --write \"src/**/*.{js,css,html}\" \"scripts/*.mjs\" \"*.md\"",
    "test": "node tests/site-test.mjs",
    "audit": "node tests/audit.mjs"
  },
  "dependencies": {
    "gsap": "^3.12.5",
    "lenis": "^1.1.18",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "eslint": "^8.57.1",
    "lighthouse": "^13.5.0",
    "prettier": "^3.3.3",
    "puppeteer": "^25.12.0",
    "puppeteer-core": "^25.12.0",
    "vite": "^5.4.11"
  }
}
